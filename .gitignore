# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Signing secrets (never commit)
*.jks
*.keystore
key.properties
android/key.properties

# Local tooling
/tool/out/
*.tmp

# Wave 5-C: signed packs copied into the Play asset pack modules for the bundle (never commit)
android/asset_packs/*/src/main/assets/

# Release signing (docs/release/RELEASING.md). The keys live outside the repository; these are a backstop.
*.p12
*.pfx
*.pem
*.password
keystore.properties
android/keystore.properties
release-keys/

# Gradle output at the Android root (not covered by the Flutter template ignore)
/android/build/
/android/.kotlin/
.design/

