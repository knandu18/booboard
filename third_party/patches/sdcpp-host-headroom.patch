-    constexpr size_t headroom = 1024ULL * 1024 * 1024;
+    // BooBoard: phones need a smaller free-RAM margin than desktops (1 GB -> 256 MB).
+    constexpr size_t headroom = 256ULL * 1024 * 1024;
     size_t available          = 0;
     auto fits                 = [&] {
         const size_t resident  = max_ram_bytes_ ? host_weight_bytes() : 0;
