<?xml version="1.0" encoding="utf-8"?>
<!-- Languages are managed inside BooBoard; one generic subtype is enough for the system.
     supportsInlineSuggestions: password managers and autofill (Android 11+) may offer
     their suggestions as chips inside BooBoard's suggestion strip. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="app.booboard.keyboard.SettingsActivity"
    android:supportsInlineSuggestions="true"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:label="@string/subtype_label"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true" />
</input-method>
